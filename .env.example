# Neon pooled connection used by the deployed application
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require

# Neon direct connection used by Drizzle migrations
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require

# Session and platform configuration
JWT_SECRET=replace-with-a-long-random-secret
BUILT_IN_FORGE_API_URL=https://replace-me.example.com
BUILT_IN_FORGE_API_KEY=replace-me

# Web Push (generate with scripts/generate-vapid.mjs)
VAPID_PUBLIC_KEY=replace-me
VAPID_PRIVATE_KEY=replace-me
VAPID_SUBJECT=mailto:admin@example.com
VITE_VAPID_PUBLIC_KEY=replace-me
